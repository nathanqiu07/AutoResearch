{
  "model": "nvidia/nemotron-3-ultra-550b-a55b:free",
  "provider": {
    "only": [
      "nvidia"
    ],
    "allow_fallbacks": false,
    "require_parameters": true,
    "max_price": {
      "prompt": 0,
      "completion": 0
    }
  },
  "max_tokens": 4096,
  "temperature": 0.6,
  "messages": [
    {
      "role": "system",
      "content": "Follow the requested tool workflow. Be concise."
    },
    {
      "role": "user",
      "content": "Use lookup_stock to check notebooks. We need 7. Tell us whether we can fill the orders and how many remain."
    }
  ],
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "lookup_stock",
        "description": "Look up inventory.",
        "parameters": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string"
            }
          },
          "required": [
            "item"
          ],
          "additionalProperties": false
        }
      }
    }
  ],
  "tool_choice": "auto",
  "reasoning": {
    "enabled": true,
    "exclude": false
  }
}
