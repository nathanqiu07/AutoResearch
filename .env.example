# AutoResearch API keys: template. Copy it to .env and fill in your own values:
#   cp .env.example .env
# .env is listed in .gitignore; never commit real keys, here or anywhere else.
# The code reads these from the environment only; load them into your shell with
#   set -a; source .env; set +a
# Every key is optional: without one, that part falls back or is skipped
# (no ANTHROPIC_API_KEY -> offline simulator, no EXA_API_KEY -> no web scout,
#  no PAST_API_KEY -> local shared-memory file).

# --- Anthropic (generator, judges, held-out Claude target; also the Batch API) ---
ANTHROPIC_API_KEY=

# --- Exa (web scout, Track S harvesting) ---
EXA_API_KEY=

# --- past.dev (shared memory across agents and runs; scripts/pastdev_smoke.py) ---
PAST_API_KEY=

# --- Modal (research-grid, vLLM dev target, sandboxes) ---
# Easiest: run `modal setup` once instead. Or set the token pair here:
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# --- Dev target served by vLLM on Modal (harness/modal_vllm.py) ---
# e.g. https://<modal-workspace>--autoresearch-vllm-serve.modal.run/v1
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
# GPU list price per hour, so its time counts toward --max-cost (one Modal H100 ~3.95)
OPENAI_COMPAT_USD_PER_HOUR=

# --- OpenAI (held-out GPT target and J2 judge in configs/models.json) ---
OPENAI_API_KEY=

# --- Hugging Face (gated benchmark datasets) ---
HF_TOKEN=
